diff --git b/internal/gateway/dm_claude_chat.go b/internal/gateway/dm_claude_chat.go
new file mode 100644
index 0000000..8f7f3c2
--- /dev/null
+++ b/internal/gateway/dm_claude_chat.go
@@ -0,0 +1,115 @@
+package gateway
+
+import (
+	"encoding/json"
+	"strings"
+
+	"github.com/yetone/magpie/internal/dmbridge"
+)
+
+// The local Claude adapter emits a frozen, non-streaming system/user pair.
+// Validate the same shape before admission and after rewriting the physical model.
+func dmClaudeChatRequest(a dmbridge.Admission, raw []byte) error {
+	if len(raw) > 262144 {
+		return dmTargetDenied
+	}
+	fields, err := dmObject(raw, "model", "messages", "max_tokens", "stream")
+	if err != nil || string(fields["stream"]) != "false" {
+		return dmTargetDenied
+	}
+	var messages []json.RawMessage
+	if json.Unmarshal(fields["messages"], &messages) != nil || len(messages) != 2 {
+		return dmTargetDenied
+	}
+	for i, role := range []string{"system", "user"} {
+		message, err := dmObject(messages[i], "role", "content")
+		var actualRole, text string
+		if err != nil || json.Unmarshal(message["role"], &actualRole) != nil || actualRole != role || json.Unmarshal(message["content"], &text) != nil || strings.TrimSpace(text) == "" {
+			return dmTargetDenied
+		}
+	}
+	return dmFinalBudget(a, fields)
+}
+
+func dmClaudeCount(fields map[string]json.RawMessage, key string) (int, bool) {
+	var v *int
+	if json.Unmarshal(fields[key], &v) != nil || v == nil || *v < 0 {
+		return 0, false
+	}
+	return *v, true
+}
+
+func dmClaudeOptionalCount(fields map[string]json.RawMessage, key string, expected int) bool {
+	if fields[key] == nil {
+		return true
+	}
+	n, ok := dmClaudeCount(fields, key)
+	return ok && n == expected
+}
+
+func dmClaudeNoCacheWrites(fields map[string]json.RawMessage) bool {
+	for _, key := range []string{"cache_creation_input_tokens", "cache_write_tokens", "cache_creation_tokens"} {
+		if !dmClaudeOptionalCount(fields, key, 0) {
+			return false
+		}
+	}
+	return true
+}
+
+// Reconcile the native counters with the billed ledger. Missing counts, including
+// missing cache observations, must never silently become a successful zero.
+func dmClaudeChatUsage(raw json.RawMessage, u Usage) bool {
+	fields, err := dmbridge.RequestFields(raw)
+	input, inputOK := dmClaudeCount(fields, "prompt_tokens")
+	output, outputOK := dmClaudeCount(fields, "completion_tokens")
+	if err != nil || !inputOK || !outputOK || !dmClaudeNoCacheWrites(fields) || u.CacheWrite != 0 || output != u.Output || input != u.Input+u.CacheRead {
+		return false
+	}
+	var details map[string]json.RawMessage
+	if raw := fields["prompt_tokens_details"]; raw != nil {
+		details, err = dmbridge.RequestFields(raw)
+		if err != nil || !dmClaudeNoCacheWrites(details) {
+			return false
+		}
+	}
+	if fields["prompt_cache_hit_tokens"] == nil && details["cached_tokens"] == nil {
+		return false
+	}
+	return dmClaudeOptionalCount(details, "cached_tokens", u.CacheRead) && dmClaudeOptionalCount(fields, "prompt_cache_hit_tokens", u.CacheRead) && dmClaudeOptionalCount(fields, "prompt_cache_miss_tokens", u.Input) && dmClaudeOptionalCount(fields, "total_tokens", input+output)
+}
+
+func dmClaudeChatReply(raw []byte, model string, u Usage) bool {
+	// Duplicate members and escaped credentials have already been checked on raw.
+	fields, err := dmbridge.RequestFields(raw)
+	var id, object, served string
+	if err != nil || json.Unmarshal(fields["id"], &id) != nil || !dmResponseID.MatchString(id) || json.Unmarshal(fields["object"], &object) != nil || object != "chat.completion" || json.Unmarshal(fields["model"], &served) != nil || served != model || fields["error"] != nil && string(fields["error"]) != "null" {
+		return false
+	}
+	var choices []json.RawMessage
+	if json.Unmarshal(fields["choices"], &choices) != nil || len(choices) != 1 {
+		return false
+	}
+	choice, err := dmObject(choices[0], "index", "finish_reason", "message", "logprobs")
+	if err != nil || string(choice["index"]) != "0" || string(choice["finish_reason"]) != "\"stop\"" {
+		return false
+	}
+	msg, err := dmObject(choice["message"], "role", "content", "refusal", "reasoning_content", "tool_calls", "function_call", "annotations")
+	var text string
+	if err != nil || string(msg["role"]) != "\"assistant\"" || json.Unmarshal(msg["content"], &text) != nil || strings.TrimSpace(text) == "" {
+		return false
+	}
+	for _, key := range []string{"refusal", "tool_calls", "function_call"} {
+		if msg[key] != nil && string(msg[key]) != "null" {
+			return false
+		}
+	}
+	var reasoning *string
+	if value := msg["reasoning_content"]; value != nil && json.Unmarshal(value, &reasoning) != nil {
+		return false
+	}
+	var annotations []json.RawMessage
+	if value := msg["annotations"]; value != nil && (json.Unmarshal(value, &annotations) != nil || len(annotations) != 0) {
+		return false
+	}
+	return dmClaudeChatUsage(fields["usage"], u)
+}
